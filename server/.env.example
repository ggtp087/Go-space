# GO SPAce API server — copy to server/.env (never commit .env).

# Connection to the local PostGIS database. The database name contains a
# space, so it is URL-encoded as GO%20SPAce.
DATABASE_URL=postgresql://thanakornpraditkanok@localhost:5432/GO%20SPAce

# Left empty for local development (the local server trusts this user).
# MUST be set to a real password before any deployment.
PGPASSWORD=

# Port the API listens on (the Vite dev server proxies /api here).
PORT=3001
